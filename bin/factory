#!/usr/bin/env bash
# factory — merge the PRs code alone can vouch for, while nobody is watching.
#
# One dispatcher over four verbs that each do one thing and log every act:
#   lease      the standing merge grant this machine's owner types
#   tier       is one PR mergeable unattended, by policy rather than judgement
#   shift      one pass: sense, merge tier 1, report the rest
#   watchdog   notice that the foreman died, which no pass can report
#
# Everything else here is the surface around them: `config`, `doctor`, `skill`.
# shellcheck source-path=SCRIPTDIR/..
set -euo pipefail

FACTORY_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export FACTORY_HOME
LIBEXEC="$FACTORY_HOME/libexec"
# Presentation only — the report verbs and snug's painter behind them. NOT
# common.sh: that reads the config and requires `jq` at source time, and
# `factory --help` must work on a machine that has neither.
# shellcheck source=lib/ui.sh
. "$FACTORY_HOME/lib/ui.sh"

usage() {
  cat <<'EOF'
factory — merge the PRs code alone can vouch for, while nobody is watching.

usage:
  factory lease grant <30m|12h|2d>    take tier-1 merge authority until then
  factory lease status [--json]       0 live · 1 none/expired
  factory lease revoke

  factory shift [--dry-run] [--json]  one pass: sense, merge, report
  factory tier <repo> <n> [--json]    is one PR tier 1?  0 yes · 3 no

  factory watchdog once|ensure [--json]   is the foreman alive?
  factory watchdog run|stop               the poller itself

  factory config print [--json]       the EFFECTIVE policy, defaults included
  factory config path                 where that file is read from
  factory config init                 write a starter config there
  factory doctor [--json]             is this machine able to run a shift?

  factory skill [<name>]              print the agent skill
  factory skill install [--client claude|codex|opencode|pi] [--dir PATH]

  factory --help · --version

exit codes
  0  ok / tier 1 / healthy       3  refused (not tier 1) · stalled foreman
  1  nothing (no lease) · pass   4  live lease with no poller watching it
     aborted                     2  usage, or a config that cannot be used

The policy lives in one machine-local file — `factory config path` — because a
copy inside a watched repo would be a file a PR could edit to widen the filter
that judges it. Full design: https://github.com/hausfold/factory
EOF
}

# `skill install` needs the same client table twice, so it is written once here.
# Each client reads skills from its own directory; the layout inside is the
# same for all of them (<dir>/<skill name>/SKILL.md).
client_dir() {
  case "$1" in
  claude) echo "$HOME/.claude/skills" ;;
  codex) echo "$HOME/.codex/skills" ;;
  opencode) echo "$HOME/.config/opencode/skills" ;;
  pi) echo "$HOME/.pi/agent/skills" ;;
  *) return 1 ;;
  esac
}

cmd_skill() {
  local sub="${1:-}"
  case "$sub" in
  "") : ;;
  install) shift; cmd_skill_install "$@"; return ;;
  -*) die "skill takes a name or 'install', not '$sub'" ;;
  esac
  # A named skill is a sibling directory; the tool's own is `ai/SKILL.md`.
  local path="$FACTORY_HOME/ai/SKILL.md"
  [ -z "${1:-}" ] || path="$FACTORY_HOME/ai/$1/SKILL.md"
  [ -f "$path" ] || die "no such skill '${1:-factory}'"
  cat "$path"
}

cmd_skill_install() {
  local dir="" client="" wrote=0 skipped=0
  while [ $# -gt 0 ]; do
    case "$1" in
    --dir) dir="${2:-}"; shift 2 ;;
    --client) client="${2:-}"; shift 2 ;;
    *) die "unknown flag '$1'" ;;
    esac
  done
  local -a targets=()
  if [ -n "$dir" ]; then
    targets=("$dir")
  elif [ -n "$client" ]; then
    local d
    d="$(client_dir "$client")" || die "unknown client '$client'"
    targets=("$d")
  else
      local c d
    for c in claude codex opencode pi; do
      d="$(client_dir "$c")"
      [ -d "$(dirname "$d")" ] && targets+=("$d")
    done
  fi
  [ "${#targets[@]}" -gt 0 ] || die "no agent client found — name one with --client or --dir"

  # Every skill this tool ships, discovered rather than listed: a tool that
  # ships a second skill and installs only its first reaches no standalone user
  # with it.
  local src name dest t
  for t in "${targets[@]}"; do
    for src in "$FACTORY_HOME/ai/SKILL.md" "$FACTORY_HOME"/ai/*/SKILL.md; do
      [ -f "$src" ] || continue
      name=factory
      [ "$src" = "$FACTORY_HOME/ai/SKILL.md" ] || name="$(basename "$(dirname "$src")")"
      dest="$t/$name/SKILL.md"
      # A haus machine has already installed this, as a read-only Nix symlink.
      # Say so, rather than making the user work it out from an EPERM.
      if [ -L "$t/$name" ] || [ -L "$dest" ]; then
        out_info "skipped $dest — a symlink, so something else manages it (on a haus machine, haus.ai.skill already did)"
        skipped=$((skipped + 1)); continue
      fi
      if [ -f "$dest" ] && ! cmp -s "$src" "$dest"; then
        out_warn "skipped $dest — exists and differs; diff it against $src"
        skipped=$((skipped + 1)); continue
      fi
      mkdir -p "$(dirname "$dest")"
      cp "$src" "$dest"
      out_ok "wrote $dest"
      wrote=$((wrote + 1))
    done
  done
  out_info "skills: $wrote written, $skipped left alone"
}

cmd_config() {
  # shellcheck source=lib/common.sh
  . "$FACTORY_HOME/lib/common.sh"
  local sub=print
  if [ $# -gt 0 ]; then sub="$1"; shift; fi
  case "$sub" in
  # A path a caller captures — `cd "$(dirname "$(factory config path)")"` is the
  # whole reason stdout carries data only. Never painted, never marked.
  path)
    [ $# -eq 0 ] || die "config path takes no flags, not '$1'"
    out_data "$FACTORY_CONFIG_PATH" ;;
  print)
    # Parsed, so an unknown flag is REFUSED rather than ignored: this used to
    # compare $2 against `--json` and fall through to the human table for
    # anything else, which is the same swallow `doctor` had.
    local json=0
    while [ $# -gt 0 ]; do
      case "$1" in
      --json) json=1 ;;
      *) die "config print takes --json, not '$1'" ;;
      esac
      shift
    done
    factory_load
    if [ "$json" = 1 ]; then
      printf '%s\n' "$FACTORY_CFG" | jq .
    else
      # The effective policy, defaults included, plus the floor the config
      # cannot lower — so what `print` shows is what `tier` will actually do.
      #
      # jq emits label and value TAB-separated and the table budgets them
      # against the window. The label column caps at its own content, so the
      # value gets everything else — which is what a `deny` list of a dozen
      # patterns needs and what the hand-spaced columns this replaced could not
      # give it: they were padded to a width chosen once, in a format string,
      # and every window narrower than that wrapped mid-pattern.
      ui_table_clear
      ui_col label 4 1 muted
      ui_col value 20 1 body
      # Into a variable first, and NOT through a process substitution: a
      # process substitution's exit status is unreachable, so a jq that failed
      # would print an empty table and exit 0. Silence is a claim here, and a
      # config nobody could read must not look like a config with nothing in it.
      local rows
      rows="$(
        printf '%s\n' "$FACTORY_CFG" |
          jq -r --argjson floor "$FACTORY_FLOOR_DENY" --arg p "$FACTORY_CONFIG_PATH" --arg d "$(factory_policy_digest)" '
            "config\t\($p)",
            "digest\t\($d)",
            "scope\torgs \(.scope.orgs | join(", ") | if . == "" then "-" else . end)  repos \(.scope.repos | length)  excluded \(.scope.exclude | length)  archived \(.scope.archived)  limit \(.scope.limit)",
            "tier1\t\(.tier1.head) → \(.tier1.base), authors \(.tier1.authors | join(",")), ≤\(.tier1.maxLines) lines, green=\(.tier1.requireGreen), merge=\(.tier1.mergeMethod)",
            "allow\t\(.tier1.allow | join("  "))",
            "deny\t\((.tier1.deny + $floor) | join("  "))",
            "budget\t\(.budget.mode), feed \(.budget.feed // "-"), ceiling \(.budget.ceiling) reserve \(.budget.reserve) fixer \(.budget.fixer) 5h-max \(.budget.window5hMax)",
            "after\t\(.afterMerge.commands | length) command(s) in \(.afterMerge.workdir // "the current directory")",
            "notify\t\(.notify.mode), source \(.notify.source)",
            "watchdog\tstale \(.watchdog.stale)s dead \(.watchdog.dead)s interval \(.watchdog.interval)s"'
      )"
      while IFS=$'\t' read -r k v; do ui_trow "$k" "$v"; done <<<"$rows"
      ui_table_data
    fi
    ;;
  init)
    [ $# -eq 0 ] || die "config init takes no flags, not '$1'"
    [ ! -f "$FACTORY_CONFIG_PATH" ] ||
      die "$FACTORY_CONFIG_PATH already exists — edit it, or delete it first"
    mkdir -p "$(dirname "$FACTORY_CONFIG_PATH")"
    cp "$FACTORY_HOME/share/config.example.json" "$FACTORY_CONFIG_PATH"
    out_ok "wrote $FACTORY_CONFIG_PATH"
    out_info "edit scope, then run: factory doctor"
    ;;
  *) die "config takes print [--json], path or init" ;;
  esac
}

cmd_doctor() {
  # shellcheck source=lib/common.sh
  . "$FACTORY_HOME/lib/common.sh"
  local json=0
  while [ $# -gt 0 ]; do
    case "$1" in
    --json) json=1 ;;
    # A flag nobody parses is worse than a flag nobody has: an agent that
    # passes one and is handed prose cannot tell "this verb has no JSON" from
    # "the JSON is malformed". Refused on fd 2, with nothing on fd 1.
    *) die "doctor takes --json, not '$1'" ;;
    esac
    shift
  done

  local bad=0 warn=0 section=""
  local -a checks=()
  # Unknown until the state section asks, and named rather than empty if it
  # never gets an answer: a doctor that could not read the lease must not emit
  # the document a machine with no lease emits.
  local lease_json='{"error":"lease-unknown"}' wd_json='{"error":"watchdog-unknown"}'

  # One check, recorded once and rendered for whichever reader asked.
  #
  # The mark carries the state and the colour is the courtesy: a doctor read
  # through `NO_COLOR`, a pipe or a dumb terminal still sorts ✓ from ✗. Under
  # `--json` that same state is a FIELD and the painter is never reached at
  # all — a JSON report bypasses `out_*` rather than stripping escapes back out
  # of it, which is what keeps `doctor --json` identical on a machine with snug
  # and a clone-and-symlink install without it.
  chk() { # chk <ok|warn|bad> <check id> <line...>
    local state="$1" id="$2"; shift 2
    case "$state" in
    warn) warn=$((warn + 1)) ;;
    bad) bad=$((bad + 1)) ;;
    esac
    if [ "$json" = 1 ]; then
      checks+=("$(jq -nc --arg s "$section" --arg c "$id" --arg st "$state" --arg l "$*" \
        '{section: $s, check: $c, state: $st, line: $l}')")
    else
      case "$state" in
      ok) out_ok "$*" ;;
      warn) out_warn "$*" ;;
      bad) out_bad "$*" ;;
      esac
    fi
  }
  # The head names the section and the section names itself in the JSON, so the
  # two readers can never be given different groupings of the same checks.
  sec()  { section="$1"; [ "$json" = 1 ] || { echo; out_head "$1"; }; }
  ok()   { chk ok   "$@"; }
  note() { chk warn "$@"; }
  bad()  { chk bad  "$@"; }

  [ "$json" = 1 ] || out_head "factory $FACTORY_VERSION — $FACTORY_HOME"

  sec tools
  if have jq; then ok jq "jq $(jq --version 2>/dev/null)"; else bad jq "jq is missing (brew install jq)"; fi
  if have gh; then
    if gh auth status >/dev/null 2>&1; then ok gh "gh authenticated as $(gh api user -q .login 2>/dev/null || echo '?')"
    else bad gh "gh is installed but not authenticated (gh auth login)"; fi
  else
    bad gh "gh is missing (brew install gh) — every verb needs it"
  fi

  sec config
  if [ -f "$FACTORY_CONFIG_PATH" ]; then ok config-file "$FACTORY_CONFIG_PATH"
  else note config-file "$FACTORY_CONFIG_PATH does not exist — running on defaults (factory config init)"; fi
  factory_load
  local n_orgs n_repos
  n_orgs=$(cfg '.scope.orgs | length'); n_repos=$(cfg '.scope.repos | length')
  if [ "$n_orgs" = 0 ] && [ "$n_repos" = 0 ]; then
    bad scope "scope names no orgs and no repos — a shift would have nothing to walk"
  else
    ok scope "scope: $n_orgs org(s), $n_repos explicit repo(s)"
  fi
  ok digest "policy digest $(factory_policy_digest)"

  sec budget
  local mode feed
  mode=$(cfg .budget.mode); feed=$(cfg '.budget.feed // ""')
  # shellcheck disable=SC2088 # a literal tilde out of the config, expanded here
  case "$feed" in "~/"*) feed="$HOME/${feed#\~/}" ;; esac
  if [ "$mode" = unmetered ]; then
    note budget "unmetered by config — every pass says fixer: yes"
  elif [ -z "$feed" ]; then
    note budget "no budget.feed configured — every pass says fixer: no (budget unknown)"
  elif [ -s "$feed" ]; then
    ok budget "feed $feed"
  else
    note budget "budget.feed $feed is missing or empty — fixer lanes stay refused"
  fi

  sec "after merge"
  local wd n_cmd
  wd=$(cfg '.afterMerge.workdir // ""'); n_cmd=$(cfg '.afterMerge.commands | length')
  # shellcheck disable=SC2088 # a literal tilde out of the config, expanded here
  case "$wd" in "~/"*) wd="$HOME/${wd#\~/}" ;; esac
  if [ "$n_cmd" = 0 ]; then note after-merge "no afterMerge commands — merges land and nothing follows"
  elif [ -n "$wd" ] && [ ! -d "$wd" ]; then bad after-merge "afterMerge.workdir does not exist: $wd"
  elif [ -n "$wd" ]; then ok after-merge "$n_cmd command(s) in $wd"
  else ok after-merge "$n_cmd command(s) in the current directory"; fi

  sec state
  if mkdir -p "$FACTORY_STATE_DIR" 2>/dev/null && [ -w "$FACTORY_STATE_DIR" ]; then
    ok state-dir "$FACTORY_STATE_DIR"
  else
    bad state-dir "state dir is not writable: $FACTORY_STATE_DIR"
  fi
  # A machine that ran the workshop's in-repo ancestor has its logs and its
  # lease under the old path. Nothing reads them any more, and a shift that
  # silently started a fresh history is exactly the kind of quiet this tool is
  # built not to be.
  local legacy="$HOME/.cache/hausfold-factory"
  [ ! -d "$legacy" ] || note legacy-state "$legacy holds an older factory's state — nothing reads it now; delete it when you have read its logs"
  # The two sub-verbs report themselves. Under `--json` they are ASKED in JSON
  # and nested whole, never scraped: one verb does not parse another's human
  # line, and their objects are already the contract a caller reads.
  if [ "$json" = 1 ]; then
    local sub
    sub=$("$LIBEXEC/factory-lease" status --json 2>/dev/null) || true
    if jq -e . >/dev/null 2>&1 <<<"${sub:-}"; then lease_json="$sub"; fi
    sub=$("$LIBEXEC/factory-watchdog" once --json 2>/dev/null) || true
    if jq -e . >/dev/null 2>&1 <<<"${sub:-}"; then wd_json="$sub"; fi
  else
    "$LIBEXEC/factory-lease" status || true
    "$LIBEXEC/factory-watchdog" once || true
  fi

  # One verdict, one exit code, computed once so the two renderings cannot
  # disagree about whether this machine is ready.
  local rc=0 line="doctor: ready"
  if [ "$bad" -gt 0 ]; then rc=2; line="doctor: $bad blocking, $warn to note"
  elif [ "$warn" -gt 0 ]; then rc=1; line="doctor: ready, $warn to note"; fi

  if [ "$json" = 1 ]; then
    # Into a variable first, so a jq that failed cannot leave a doctor printing
    # nothing and exiting 0 — the whole report is the claim here.
    local doc
    doc=$(printf '%s\n' ${checks[@]+"${checks[@]}"} |
      jq -s --arg v "$FACTORY_VERSION" --arg h "$FACTORY_HOME" --arg l "$line" \
        --argjson blocking "$bad" --argjson notes "$warn" --argjson exit "$rc" \
        --argjson lease "$lease_json" --argjson watchdog "$wd_json" \
        '{version: $v, home: $h, ready: ($blocking == 0), blocking: $blocking,
          notes: $notes, exit: $exit, line: $l, checks: ., lease: $lease,
          watchdog: $watchdog}') || die "doctor could not build its JSON report"
    out_data "$doc"
    return "$rc"
  fi

  echo
  case "$rc" in
  2) out_bad "$line" ;;
  1) out_warn "$line" ;;
  *) out_ok "$line" ;;
  esac
  return "$rc"
}

case "${1:-}" in
lease | tier | shift | watchdog)
  verb="$1"; shift
  exec "$LIBEXEC/factory-$verb" "$@"
  ;;
config) shift; cmd_config "$@" ;;
doctor) shift; cmd_doctor "$@" ;;
skill) shift; cmd_skill "$@" ;;
-h | --help | help | "") usage ;;
-V | --version | version) cat "$FACTORY_HOME/VERSION" ;;
*)
  # Both on fd 2: an unknown verb is not a report, so neither line lands on the
  # stream a report is captured off.
  fail "unknown verb '$1'"
  hint "try: factory --help"
  exit 2
  ;;
esac
