#!/usr/bin/env bash
# factory-lease — the standing merge grant the shift runs under.
#
#   factory lease grant 12h     # tier-1 authority for 12 hours
#   factory lease status        # exit 0 live · 1 none/expired
#   factory lease revoke
#
# A lease is (tier ceiling, expiry). While one is live, `factory shift` may
# MERGE tier-1 PRs on its own; expired or revoked, everything queues at "PR
# open" — i.e. the failure mode of the whole factory is the ordinary
# human-in-the-loop workflow. Only tier 1 exists today; the column is there so
# a wider grant is a new value, not a new file format.
#
# State is one TSV line — <expires epoch>\t<tier>\t<granted epoch> — under the
# state dir, machine-local on purpose: authority to merge unattended belongs to
# this machine's owner having typed `grant`, never to a file a PR could edit.
# Every jq program in this file is single-quoted on purpose: `$d`, `$repo` and
# the rest are jq's OWN variables, bound by --arg/--argjson, and expanding them
# in the shell first is exactly the bug the quoting prevents.
# shellcheck disable=SC2016
# shellcheck source-path=SCRIPTDIR
set -euo pipefail
# shellcheck source=../lib/common.sh
. "$(dirname "$0")/../lib/common.sh"
factory_load

LEASE="$FACTORY_STATE_DIR/lease"
WATCHDOG="$(dirname "$0")/factory-watchdog"
json=0
args=()
for a in "$@"; do
  case "$a" in --json) json=1 ;; *) args+=("$a") ;; esac
done
set -- ${args[@]+"${args[@]}"}

usage() {
  cat >&2 <<'EOF'
usage:
  factory lease grant <duration>   # 30m / 12h / 2d — tier-1 authority until then
  factory lease status [--json]    # exit 0 live · 1 none/expired
  factory lease revoke
EOF
  exit 2
}

parse_duration() { # 30m / 12h / 2d → seconds
  # The number half is SPLIT OFF first and checked before anything computes
  # on it, because every way of not being a number here is quiet one frame
  # later. The unit arms only say where to cut and by how much to multiply.
  local n mult bare secs
  case "$1" in
  *m) n="${1%m}"; mult=60 ;;
  *h) n="${1%h}"; mult=3600 ;;
  *d) n="${1%d}"; mult=86400 ;;
  *s) n="${1%s}"; mult=1 ;;
  # No unit to cut at: the empty `n` is what refuses it two lines down, and
  # `mult` is 0 because nothing may reach the division below on this arm.
  *)  n=""; mult=0 ;;
  esac
  # `num` (lib/common.sh) is what already answers "a non-empty run of digits"
  # for the feed's columns and this file's own lease fields. Asked here, it
  # is what catches a unit with no digits in front of it: `${1%h}` on "h"
  # leaves "", and `$(( * 3600))` is a bash arithmetic syntax error — the
  # user gets that raw message at exit 1, where every other refusal in this
  # verb is `die` at exit 2, the usage row of the exit-code table. On "s" the
  # same "" is worse, because "" is a VALID arithmetic operand (0). It also
  # catches "1h2m", "5.5h" and a bare "12": each leaves a remainder that is
  # not digits, or no unit to cut at all.
  num "$n" || die "bad duration '$1' (use 30m, 12h, 2d)"
  # Leading zeros are not magnitude, so they come off before the length is
  # measured: `0000001m` is one minute, not a complaint about size.
  bare="$n"
  while [ "${bare#0}" != "$bare" ]; do bare="${bare#0}"; done
  # Refused on the STRING, because bash counts in signed 64-bit and `10#`
  # turns the digits into a number before anything here could compare them.
  # 2^63 wraps to negative, which the zero check below would then refuse with
  # a sentence that is not true of what was typed.
  [ "${#bare}" -le 18 ] ||
    die "duration '$1' is more seconds than this machine can count"
  # 10# because `num` passes a leading zero and bash reads one as octal. `08h`
  # is then a fatal "value too great for base" — raw, on fd 2, exit 1 again —
  # and `010m` is worse for being survivable: it grants EIGHT minutes wearing
  # a ten. The feed columns are read through the same prefix, one file over.
  n=$((10#$n))
  # Zero grants cleanly, marks the line ✓, and is expired by the time `status`
  # reads it back.
  [ "$n" -gt 0 ] ||
    die "duration '$1' is zero — a lease granted for no time is one already expired"
  # The multiply leaves the range even where the number did not. What that
  # wrap costs is on the `grant` arm, which checks the other half — this
  # function cannot see the clock its answer is added to.
  secs=$((n * mult))
  if [ "$secs" -le 0 ] || [ "$((secs / mult))" != "$n" ]; then
    die "duration '$1' is more seconds than this machine can count"
  fi
  echo "$secs"
}

emit() { # emit <live> <tier> <expires> <granted> <human line>
  if [ "$json" = 1 ]; then
    jq -nc --argjson live "$1" --argjson tier "$2" --argjson expires "$3" \
      --argjson granted "$4" --arg line "$5" \
      '{live: $live, tier: $tier, expires: $expires, granted: $granted,
        secondsLeft: (if $live then ($expires - (now | floor)) else 0 end), line: $line}'
  elif [ "$1" = true ]; then
    out_ok "$5"
  else
    # Not a warning. No lease, an expired one and a revoked one are the ordinary
    # answers to "may you merge?", and marking them ⚠ would make the quiet state
    # of this machine look like something went wrong every time doctor ran.
    out_info "$5"
  fi
}

now=$(date +%s)
case "${1:-}" in
grant)
  [ -n "${2:-}" ] || usage
  secs=$(parse_duration "$2")
  tier="${3:-1}"
  [ "$tier" = 1 ] || die "only tier 1 exists — widen tier1.allow instead; a wider grant would be a new tier value here"
  # The EXPIRY is what gets written, so it is checked here, where the clock it
  # is added to is in scope. Both ways of not being one are the same failure to
  # whoever reads the line: `now + secs` past 2^63 wraps negative, and `status`
  # then calls the state file this verb has just written unreadable; an expiry
  # `date` will not format leaves the ✓ ending on a bare "until", because `at`
  # answers with nothing. A duration can clear parse_duration and still land
  # on either — 106751991167300d multiplies without wrapping.
  expires=$((now + secs))
  # `|| when=""` because a `date` that refuses the stamp exits non-zero, and
  # under `set -e` that status inside a command substitution ends the script
  # before the check below can turn it into a sentence. The empty answer IS
  # the signal here, so it is caught rather than propagated.
  when=$(at "$expires") || when=""
  if [ "$expires" -le "$now" ] || [ -z "$when" ]; then
    die "duration '$2' puts the expiry past what this machine can represent"
  fi
  mkdir -p "$FACTORY_STATE_DIR"
  printf '%s\t%s\t%s\n' "$expires" "$tier" "$now" >"$LEASE"
  emit true "$tier" "$expires" "$now" "lease: tier $tier until $when"
  # A live lease always has a watchdog, and it is started HERE rather than by
  # the foreman so the invariant is structural: the one thing that must not
  # depend on the agent still working is the thing that notices it stopped.
  # `ensure` is idempotent (one pidfile per machine, claimed by hardlink), so a
  # second grant inside a live shift extends the lease without racing — and it
  # is the same verb the foreman re-runs each wakeup, so there is one
  # implementation of "make sure something is watching".
  if [ "${FACTORY_NO_WATCHDOG:-0}" != 1 ] && [ -x "$WATCHDOG" ]; then
    "$WATCHDOG" ensure >/dev/null 2>&1 || true
  fi
  ;;
status)
  if [ ! -s "$LEASE" ]; then emit false 0 0 0 "lease: none"; exit 1; fi
  # The granted stamp is the third field; `_` consumes it where nothing reads it.
  IFS=$'\t' read -r expires tier granted <"$LEASE"
  num "${expires:-}" || { emit false 0 0 0 "lease: unreadable"; exit 1; }
  num "${granted:-}" || granted=0
  num "${tier:-}" || tier=0
  if [ "$now" -ge "$expires" ]; then
    emit false "$tier" "$expires" "$granted" "lease: expired $(at "$expires")"; exit 1
  fi
  left=$(((expires - now) / 60))
  emit true "$tier" "$expires" "$granted" \
    "lease: tier $tier · $((left / 60))h $((left % 60))m left · until $(at "$expires")"
  ;;
revoke)
  rm -f "$LEASE"
  # The watchdog exits on its own the next time it reads a dead lease, but that
  # is up to one poll interval of a poller outliving the thing it watches.
  # Stopping it here keeps "no lease" and "nothing running" the same moment.
  if [ -x "$WATCHDOG" ]; then "$WATCHDOG" stop >/dev/null 2>&1 || true; fi
  emit false 0 0 0 "lease: revoked"
  ;;
*) usage ;;
esac
